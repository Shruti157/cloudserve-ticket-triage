# Copy this file to .env and fill in your own values.
# .env is gitignored. Never put a real key in this file.

# Model access. Supported providers: groq, openrouter.
# Groq is the default: its free tier allows 1,000 requests a day against
# OpenRouter's 50, and a full run over the ticket set needs roughly 200.
# Get a key at https://console.groq.com/keys (no card required).
LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
MODEL_NAME=qwen/qwen3.8-27b

# Only needed if you set LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=your_key_here

# Retrieval. "lexical" needs no model download and is the default (ADR-002).
# "embedding" additionally requires: pip install -r requirements-embedding.txt
RETRIEVAL_BACKEND=lexical
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
CACHE_PATH=./storage/llm_cache.sqlite

LOG_LEVEL=INFO

# Set from the development set, not taken from the brief's diagram. See
# docs/architecture.md ADR-004 and evaluation/results/calibration.md.
CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.45

# Free-tier pacing. Groq's binding limit is tokens per minute, not per day.
TOKENS_PER_MINUTE=8000

# Kill switch: if this file exists, the system escalates everything and sends nothing.
KILL_SWITCH_PATH=./storage/KILL_SWITCH
