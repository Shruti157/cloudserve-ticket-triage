# Copy this file to .env and fill in your own values.
# .env is gitignored. Never put a real key in this file.

# Model access. Supported providers: groq, openrouter.
# Groq is the default: its free tier allows 1,000 requests a day against
# OpenRouter's 50, and a full run over the ticket set needs roughly 200.
# Get a key at https://console.groq.com/keys (no card required).
LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
MODEL_NAME=qwen/qwen3.8-27b

# Only needed if you set LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=your_key_here

# Retrieval. BM25 over section chunks, no model download, no vector store.
# This is the only backend implemented, deliberately: see docs/architecture.md
# ADR-002 for why lexical wins on a 29-article corpus and ADR-003 for why no
# embedding dependency is carried. build_index() takes a backend argument so a
# second one can be added without touching the pipeline.
RETRIEVAL_BACKEND=lexical

DATABASE_URL=sqlite:///./storage/decisions.db
CACHE_PATH=./storage/llm_cache.sqlite

LOG_LEVEL=INFO

# Set from the development set, not taken from the brief's diagram. The sweep
# behind them is evaluation/results/retrieval_tuning.json; the reasoning, and
# an honest account of how little the confidence threshold does, is in
# docs/architecture.md ADR-004.
CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.45

# Free-tier pacing. Tokens per minute is the limit that sets how long a run
# takes; there is also a daily token cap that appears in no response header.
# Run `python -m scripts.probe_limits` to see what your own key is given.
TOKENS_PER_MINUTE=8000

# Kill switch: if this file exists, the system escalates everything and sends nothing.
KILL_SWITCH_PATH=./storage/KILL_SWITCH
