# Secrets. Never commit a real key.
.env

# Course materials. Supplied reading and templates, not part of the system.
# The two datasets it carries are byte-identical to the copies in data/, which
# are committed, so nothing here is needed to build or run anything.
Capstone_Pack/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Runtime state. The decision log stores ticket subject and body, so committing it
# would republish the course ticket sets in another form. evaluation/results/ holds
# the per-ticket outcomes instead, which carry no ticket text.
storage/
!storage/.gitkeep

# OS
.DS_Store
